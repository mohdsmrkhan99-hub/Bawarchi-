generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  staff     Staff[]
}

model Branch {
  id              String           @id @default(uuid())
  restaurantId    String
  name            String
  code            String
  address         String?
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floors          Floor[]
  sections        Section[]
  staff           Staff[]
  reservations    Reservation[]
  tableOperations TableOperation[]
  menuCategories  MenuCategory[]
  menuAddOns      MenuAddOn[]
  orders          Order[]
  kotSequence     KOTSequence?
  kots            KOT[]
  orderSequence   OrderSequence?
  billSequence    BillSequence?
  bills           Bill[]
  printers        Printer[]
  printJobs       PrintJob[]
  auditLogs       AuditLog[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

model MenuCategory {
  id           String         @id @default(uuid())
  branchId     String
  parentId     String?
  name         String
  description  String?
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent       MenuCategory?  @relation("MenuCategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuCategory[] @relation("MenuCategoryHierarchy")
  items        MenuItem[]

  @@unique([branchId, parentId, name])
  @@index([branchId, displayOrder])
  @@index([parentId, displayOrder])
}

model MenuItem {
  id           String          @id @default(uuid())
  categoryId   String
  name         String
  description  String?
  imageUrl     String?
  isVegetarian Boolean         @default(false)
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  isAvailable  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  category     MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants     MenuVariant[]
  addOns       MenuItemAddOn[]
  orderItems   OrderItem[]

  @@unique([categoryId, name])
  @@index([categoryId, displayOrder])
  @@index([isActive, isAvailable])
}

model MenuVariant {
  id           String      @id @default(uuid())
  itemId       String
  name         String
  price        Decimal     @db.Decimal(10, 2)
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  isAvailable  Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  item         MenuItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([itemId, name])
  @@index([itemId, displayOrder])
}

model MenuAddOn {
  id           String          @id @default(uuid())
  branchId     String
  name         String
  price        Decimal         @db.Decimal(10, 2)
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  isAvailable  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items        MenuItemAddOn[]

  @@unique([branchId, name])
  @@index([branchId, displayOrder])
}

model MenuItemAddOn {
  itemId  String
  addOnId String
  item    MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  addOn   MenuAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([itemId, addOnId])
  @@index([addOnId])
}

model Floor {
  id           String        @id @default(uuid())
  branchId     String
  name         String
  description  String?
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sections     Section[]
  tables       DiningTable[]

  @@index([branchId])
}

model Section {
  id           String        @id @default(uuid())
  branchId     String
  floorId      String
  name         String
  description  String?
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tables       DiningTable[]
  reservations Reservation[]
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([floorId])
}

model DiningTable {
  id               String           @id @default(uuid())
  floorId          String
  sectionId        String?
  tableNumber      String
  name             String?
  capacity         Int              @default(4)
  status           TableStatus      @default(AVAILABLE)
  displayOrder     Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  floor            Floor            @relation(fields: [floorId], references: [id], onDelete: Restrict)
  section          Section?         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  reservations     Reservation[]
  sourceOperations TableOperation[] @relation("SourceTable")
  targetOperations TableOperation[] @relation("TargetTable")
  orders           Order[]

  @@index([floorId, tableNumber])
  @@index([sectionId])
  @@index([status])
}

model Reservation {
  id            String            @id @default(uuid())
  branchId      String
  sectionId     String?
  tableId       String
  customerName  String
  customerPhone String?
  partySize     Int
  startsAt      DateTime
  endsAt        DateTime
  status        ReservationStatus @default(CONFIRMED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  section       Section?          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  table         DiningTable       @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@index([branchId, startsAt])
  @@index([tableId, startsAt])
}

model TableOperation {
  id                 String             @id @default(uuid())
  branchId           String
  sourceTableId      String
  targetTableId      String?
  operation          TableOperationType
  details            Json?
  performedByStaffId String?
  createdAt          DateTime           @default(now())
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceTable        DiningTable        @relation("SourceTable", fields: [sourceTableId], references: [id], onDelete: Restrict)
  targetTable        DiningTable?       @relation("TargetTable", fields: [targetTableId], references: [id], onDelete: Restrict)
  performedBy        Staff?             @relation(fields: [performedByStaffId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([sourceTableId])
  @@index([targetTableId])
}

model Staff {
  id              String           @id @default(uuid())
  restaurantId    String
  branchId        String?
  username        String
  fullName        String
  phone           String?
  email           String?
  passwordHash    String?
  status          StaffStatus      @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branch          Branch?          @relation(fields: [branchId], references: [id])
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roles           StaffRole[]
  tableOperations TableOperation[]
  createdOrders   Order[]          @relation("OrderCreatedBy")
  updatedOrders   Order[]          @relation("OrderUpdatedBy")
  auditLogs       AuditLog[]

  @@unique([restaurantId, username])
  @@index([restaurantId])
  @@index([branchId])
}

model Role {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  staff       StaffRole[]
}

model AuditLog {
  id         String   @id @default(uuid())
  branchId   String?
  staffId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([staffId, createdAt])
}

model StaffRole {
  staffId String
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
  @@index([roleId])
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  PREPARING
  READY
  BILL_REQUESTED
  CLEANING
  OUT_OF_SERVICE
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TableOperationType {
  MOVE
  TRANSFER
  MERGE
  SPLIT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  KOT_SENT
  PREPARING
  READY
  SERVED
  BILLED
  PAID
  COMPLETED
  CANCELLED
  ARCHIVED
}

model OrderSequence {
  branchId   String @id
  nextNumber Int    @default(1)
  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Order {
  id              String       @id @default(uuid())
  branchId        String
  orderNumber     String       @unique
  orderType       OrderType
  status          OrderStatus  @default(DRAFT)
  tableId         String?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  notes           String?
  subtotal        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  tax             Decimal      @default(0) @db.Decimal(12, 2)
  serviceCharge   Decimal      @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  version         Int          @default(1)
  idempotencyKey  String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table           DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  createdBy       Staff?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       Staff?       @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items           OrderItem[]
  kots            KOT[]
  bill            Bill?

  @@unique([branchId, idempotencyKey])
  @@index([branchId, status, createdAt])
  @@index([tableId, status])
}

model BillSequence {
  branchId   String @id
  nextNumber Int    @default(1)
  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Bill {
  id             String     @id @default(uuid())
  branchId       String
  orderId        String     @unique
  billNumber     String     @unique
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  tax            Decimal    @default(0) @db.Decimal(12, 2)
  serviceCharge  Decimal    @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  status         BillStatus @default(OPEN)
  idempotencyKey String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments       Payment[]
  printJobs      PrintJob[]

  @@unique([branchId, idempotencyKey])
  @@index([branchId, status, createdAt])
}

enum BillStatus {
  OPEN
  PAID
  VOID
}

model Payment {
  id             String        @id @default(uuid())
  billId         String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(SUCCESS)
  reference      String?
  idempotencyKey String?
  createdAt      DateTime      @default(now())
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([billId, idempotencyKey])
  @@index([billId, createdAt])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

enum PaymentStatus {
  SUCCESS
  VOID
  REFUNDED
}

model Printer {
  id             String            @id @default(uuid())
  branchId       String
  name           String
  type           String
  connectionType PrinterConnection @default(BROWSER)
  ipAddress      String?
  port           Int?
  paperWidth     Int               @default(80)
  purpose        PrinterPurpose
  station        String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printJobs      PrintJob[]

  @@index([branchId, purpose, isActive])
}

enum PrinterConnection {
  NETWORK
  USB
  LOCAL_AGENT
  BROWSER
}

enum PrinterPurpose {
  BILL
  KOT
  KITCHEN
}

model PrintJob {
  id             String            @id @default(uuid())
  branchId       String
  documentType   PrintDocumentType
  orderId        String?
  kotId          String?
  billId         String?
  printerId      String?
  status         PrintJobStatus    @default(QUEUED)
  attemptCount   Int               @default(0)
  idempotencyKey String?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  printedAt      DateTime?
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printer        Printer?          @relation(fields: [printerId], references: [id], onDelete: SetNull)
  bill           Bill?             @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@unique([branchId, idempotencyKey])
  @@index([branchId, status, createdAt])
}

enum PrintDocumentType {
  BILL
  RECEIPT
  KOT
  TEST
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
  CANCELLED
}

model KOTSequence {
  branchId   String @id
  nextNumber Int    @default(1)
  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model KOT {
  id             String    @id @default(uuid())
  branchId       String
  orderId        String
  kotNumber      String    @unique
  status         KOTStatus @default(NEW)
  notes          String?
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items          KOTItem[]

  @@unique([branchId, idempotencyKey])
  @@index([branchId, status, createdAt])
  @@index([orderId, createdAt])
}

model KOTItem {
  id          String        @id @default(uuid())
  kotId       String
  orderItemId String
  itemName    String
  variantName String?
  quantity    Int
  notes       String?
  status      KOTItemStatus @default(QUEUED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  kot         KOT           @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([kotId, status])
  @@index([orderItemId])
}

model OrderItem {
  id            String       @id @default(uuid())
  orderId       String
  menuItemId    String?
  menuVariantId String?
  itemName      String
  variantName   String?
  unitPrice     Decimal      @db.Decimal(10, 2)
  quantity      Int
  notes         String?
  lineTotal     Decimal      @db.Decimal(12, 2)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotItems      KOTItem[]
  menuItem      MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuVariant   MenuVariant? @relation(fields: [menuVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum KOTStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KOTItemStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED
}
